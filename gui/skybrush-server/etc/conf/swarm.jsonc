{
  "EXTENSIONS": {
    "http_server": {
      "host": ""
    },

    // Stream A: each drone's serial1 MAVLink feed (udpclient to port 14550 on
    // this machine) lands here. This is what Skybrush Live shows: position,
    // battery, mode, and the stock arm/takeoff/RTL controls.
    "mavlink": {
      "enabled": true,
      "networks": {
        "mav": {
          "connections": ["default"]
        }
      }
    },

    // Offline maps: Live asks this extension for map tiles, which it downloads
    // once, keeps on disk and serves again when the server has no internet.
    // Put the Mapbox token in the MAPBOX_ACCESS_TOKEN environment variable (do
    // not commit it here), or leave it unset to use the key from Live's
    // Settings -> API keys. Turn on "Use cached map tiles" in Toolbox ->
    // Offline maps, and pan over the area while online to fill the cache.
    "map_cache": {
      "enabled": true
    },

    // Terrain: ground elevation (SRTM, 30 m) for the shaded-relief map overlay
    // in Live, height-above-ground warnings and terrain data for the drones.
    // Tiles are downloaded on first use and kept on disk, so an area you have
    // seen once keeps working offline. prefetch_areas are downloaded in the
    // background at every start while online (tiles already on disk are
    // skipped), so these places are ready for offline use. To prepare another
    // area, add it here or POST {"lat": .., "lon": .., "radius_km": ..} to
    // http://<server>:5000/terrain/prefetch (Live's Terrain layer has a
    // "Download this area" button too). The area below is the SITL home.
    "terrain": {
      "enabled": true,
      // Ready-made SRTM1 (30 m) tiles downloaded by hand from
      // terrain.ardupilot.org for the SITL area (N12E079, N12E080, N13E079,
      // N13E080). They are read first and need no internet. The ArduPilot .DAT
      // versions of the same tiles, for the drones' SD cards or SITL, are in
      // the "terrain" folder next to this "hgt" one.
      "data_dirs": ["C:/Users/casr5/Documents/swarm_env/terrain/ardupilot/hgt"],
      "prefetch_areas": [{ "lat": 12.9289, "lon": 80.0464, "radius_km": 30 }],
      // Show a warning when a drone is closer than this to the ground, now or
      // within lookahead_s seconds at its current velocity.
      "min_clearance_m": 30,
      "lookahead_s": 10
    },

    // Stream B stays between the drones and main.py (swarm code). This
    // extension only forwards swarm operations (goal, search, split, stop...)
    // from Live to main.py over UDP.
    "swarm_bridge": {
      "enabled": true,
      // Where main.py listens for commands: the IP it prints as "Ip address:"
      // at startup (run_main.bat's bind IP). 172.24.96.1 is the Windows-side
      // WSL address for local SITL testing; on the real two-machine setup it
      // is the swarm-master machine's IP.
      "command_host": "192.168.31.15",
      "command_port": 12008,
      // Skybrush UAV id (MAVLink system id) -> main.py id, for drones whose
      // two ids differ. Ids not listed are passed through unchanged. Example:
      // "id_map": { "11": "1", "12": "2", "13": "3" }
      "id_map": {}
    }
  }
}
